[Unit]
Description=Conductor Service configuration for %f
Requires=caddy.service
After=caddy.service

# Ensures that the unit is restarted when the Caddy server restarts (required to
# refresh the caddy config)
PartOf=caddy.service

[Service]
WorkingDirectory=%f
TimeoutStartSec=0
RemainAfterExit=yes

Environment=CONDUCTOR_LOG_COMMAND=1
Environment=CONDUCTOR_SYSTEMD_UNIT=%n

ExecStartPre=-conductor     _ service deregister %f
ExecStartPre=conductor      _ service register %f
ExecStart=/bin/true
ExecReload=conductor        _ service register %f
ExecStopPost=exec conductor _ service deregister %f
