[Unit]
Description=Conductor service %f
Wants=conductor-service-config@%i.service

[Service]
WorkingDirectory=%f
TimeoutStartSec=0
Restart=on-failure
Type=notify
NotifyAccess=all
TimeoutSec=300
RemainAfterExit=yes

Environment=CONDUCTOR_LOG_COMMAND=1
Environment=CONDUCTOR_SYSTEMD_UNIT=%n

# Do not use notify-reload as systemd cannot detect the ready signal at the end
# of the reload because of a mismatching PID. Type=notify is enough, end of
# reload is signaled by the exit of the reload process.
# Type=notify-reload

ExecStart=conductor    _ service start   %f
ExecReload=conductor   _ service reload  %f
ExecStop=conductor     _ service stop    %f
ExecStopPost=conductor _ service cleanup %f

[Install]
WantedBy=default.target

